{
  "name": "ohmytab",
  "description": "Tab Management Extension",
  "version": "3.0.0",
  "author": "hrontan",
  "dependencies": {
    "picomatch": "4.0.7",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@tsconfig/recommended": "1.0.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/chrome": "0.3.6",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "ifdef-loader": "2.3.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "GPL3",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": "https://github.com/hrontan/OhMyTab",
  "scripts": {
    "build": "node scripts/build/build.ts all",
    "build-chrome": "node scripts/build/build.ts chrome",
    "build-firefox": "node scripts/build/build.ts firefox",
    "zip": "node scripts/distribution/zip.ts all",
    "zip-chrome": "node scripts/distribution/zip.ts chrome",
    "zip-firefox": "node scripts/distribution/zip.ts firefox",
    "clean": "node scripts/build/clean.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json --noEmit && pnpm run typecheck:tooling && pnpm run typecheck:store",
    "test": "pnpm run test:chrome && pnpm run test:firefox",
    "test:chrome": "vitest run --mode chrome",
    "test:firefox": "vitest run --mode firefox",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "typecheck:store": "tsc --project resource/store/tsconfig.json",
    "test:benchmark-lifecycle": "node --test tests/benchmarks/lifecycle.test.ts",
    "test:build": "node --test tests/tooling/build-clean.test.ts",
    "test:zip": "node --test tests/tooling/zip.test.ts",
    "test:lint": "node --test tests/tooling/lint-config.test.ts"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0"
}
